{
  "name": "@ddtcorex/maestro-reviewer",
  "private": false,
  "version": "0.15.1",
  "description": "Maestro Reviewer: the AI merge request review engine and its GitLab CI flow (resolve job, reviewer image, templates)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddtcorex/maestro-reviewer.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "cordis.patch.yml",
    "lib",
    "src",
    "skills",
    "presets",
    "profiles",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "NODE_ENV=test vitest run",
    "verify": "tsc -p tsconfig.json --noEmit",
    "docker:build": "docker build -f docker/Dockerfile -t ddtcorex/maestro-reviewer:0.15.1 -t ddtcorex/maestro-reviewer:latest ."
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/maestro-reviewer.patch.yml",
        "./presets/maestro-auditor.patch.yml"
      ]
    }
  },
  "packageManager": "pnpm@11.7.0"
}
