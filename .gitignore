node_modules/
# Anchored to the repo root: a bare lib/ also matches nested directories
# (scripts/lib/), which silently leaves files there untracked.
/lib/
.DS_Store

# Re-include coordination files ignored by the global core.excludesFile
!AGENTS.md
!CLAUDE.md

# DSH scaffolds this profile root entry list on load; never commit it.
profiles/reviewer-ci/cordis.yml

# tsc client output (tsconfig.client.json outDir), like core's lib/: build artifact.
.client-build/
